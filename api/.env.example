# Copy this file to .env and fill in your Neon connection string.
# Find it in the Neon console → your project → Connection Details → Connection string.

DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require

# Optional: port for the API server (default 3001)
# PORT=3001

# ── Document storage ────────────────────────────────────────────────────
# Any S3-compatible object store. Cloudflare R2 is the cheapest fit — it
# charges nothing for egress, and jobsite photos are read far more often
# than they are written. AWS S3 and MinIO work with the same four values.
#
# The Documents tab returns a clear "storage is not configured" until these
# are set; nothing else in the app depends on them.
#
# R2: create a bucket, then an API token with Object Read & Write on it.
#     The endpoint is https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=forcecorp-documents
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# Optional: 'auto' is what R2 expects. AWS S3 wants its real region.
# S3_REGION=auto
# Optional: per-file upload ceiling in bytes (default 100 MB)
# S3_MAX_UPLOAD_BYTES=104857600
#
# ── REQUIRED: a CORS rule on the bucket ─────────────────────────────────
# The browser uploads file bytes straight to the bucket with a presigned PUT,
# so the bucket must allow it. A new R2 or S3 bucket has NO CORS rules, the
# preflight is refused, and every upload fails with "Failed to fetch" while
# folders, previews and downloads keep working — those are navigations and
# need no CORS. Nothing on the server can detect or fix this.
#
# R2: dashboard -> your bucket -> Settings -> CORS Policy. S3: the bucket's
# Permissions tab. Replace the origin with your real domain (add
# http://localhost:3001 too if you run the dev server):
#
#   [
#     {
#       "AllowedOrigins": ["https://your-app.vercel.app"],
#       "AllowedMethods": ["PUT", "GET", "HEAD"],
#       "AllowedHeaders": ["content-type"],
#       "ExposeHeaders":  ["etag"],
#       "MaxAgeSeconds":  3600
#     }
#   ]
#
# HEAD is not optional: registration HEADs the object to record its real size
# rather than trusting what the browser claimed.
